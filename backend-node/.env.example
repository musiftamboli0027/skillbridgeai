# Server Configuration
PORT=5000
NODE_ENV=production
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=30d
JWT_REFRESH_SECRET=your_refresh_secret_here

# Database
MONGO_URI=mongodb+srv://user:pass@cluster0.mongodb.net/skillbridge

# URLs
FRONTEND_URL=https://skillbridge-ui.onrender.com
BACKEND_URL=https://skillbridge-api.onrender.com

# Email (Nodemailer + Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
FROM_NAME=SkillBridge AI
FROM_EMAIL=noreply@skillbridge.ai

# Optional: GitHub Integration
GITHUB_CLIENT_ID=your_id
GITHUB_CLIENT_SECRET=your_secret
